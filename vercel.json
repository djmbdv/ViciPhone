{
  "version": 2,
  "builds": [
    { "src": "api/[...all].js", "use": "@vercel/node" }
  ],
  "functions": {
    "api/[...all].js": {
      "runtime": "nodejs24.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/api/viciphone" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}
