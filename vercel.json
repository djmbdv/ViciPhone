{
  "version": 2,
  "builds": [
    {
      "src": "api/[...all].js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/**",
          "Source/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/api/viciphone" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}
